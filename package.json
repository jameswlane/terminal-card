{
  "name": "jameswlane",
  "version": "0.0.0-development",
  "description": "James W Lane's personal npm card",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "jameswlane": "./bin/cli.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf lib coverage",
    "lint": "biome check src tests bin vitest.config.ts",
    "lint:fix": "biome check --write src tests bin vitest.config.ts",
    "format": "biome format --write src tests bin vitest.config.ts",
    "prepack": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jameswlane/terminal-card.git"
  },
  "keywords": [
    "npx",
    "card"
  ],
  "author": "James W. Lane",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jameswlane/terminal-card/issues"
  },
  "homepage": "https://github.com/jameswlane/terminal-card#readme",
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "supports-hyperlinks": "^4.6.0"
  }
}
